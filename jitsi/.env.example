# Jitsi 本地开发环境配置 - 示例文件
# 复制此文件为 .env 并填写实际值
#
# ============================================================================
# ⚠️ 常见坑与注意事项（配置前必读）：
#
# 1. CONFIG 目录路径
#    - 必须是相对路径（如 ./jitsi-meet-cfg），不要用绝对路径
#    - 首次启动前需确保目录存在且权限正确，否则 Docker 会报 "mounts denied"
#    - 路径不要包含中文或空格
#
# 2. SSL 证书（mkcert 自签）
#    - ./certs/jitsi.crt 和 jitsi.key 必须存在，否则 web 容器无法启动
#    - 证书的 SAN 必须包含局域网 IP，否则浏览器 WSS 连接会静默失败
#      （浏览器可跳过证书警告，但 JS 发起的 WebSocket 无法跳过）
#    - IP 变更后必须重新生成证书：
#      cd certs && mkcert -key-file jitsi.key -cert-file jitsi.crt localhost 127.0.0.1 <新IP> ::1
#    - 使用 ./start.sh 可自动处理 IP 变更 + 证书重新生成
#
# 3. LOCAL_IP 变量
#    - PUBLIC_URL / JVB_ADVERTISE_URLS / JVB_ADVERTISE_IPS 通过 ${LOCAL_IP} 引用
#    - 不要直接改这三个变量的值，只改 LOCAL_IP 即可
#    - LOCAL_IP 必须是局域网可达的 IP，不能用 0.0.0.0 或 127.0.0.1
#
# 4. JWT 鉴权
#    - JWT_APP_SECRET 必须与后端 silan-asr-service 的 JWT_SHARED_SECRET 完全一致
#    - 否则前端拿到的 JWT 会被 Prosody 拒绝，会议无法加入
#    - JWT_APP_ID / JWT_ACCEPTED_ISSUERS / JWT_ACCEPTED_AUDIENCES 也要与后端对齐
#
# 5. 端口冲突
#    - JVB_HTTP_PORT 默认 19088（不要和后端 ASR 服务的 19087 冲突）
#    - HTTPS_PORT 19447 / JVB_PORT 19107(UDP) 不要被其他服务占用
#
# 6. Docker 重启后 jvb.conf 被覆盖
#    - JVB 容器启动时会自动生成 jvb.conf，手动修改不生效
#    - 需要自定义 JVB 配置时通过 .env 的环境变量控制
#
# 7. 首次启动顺序
#    - Prosody 必须先于 Jicofo/JVB 启动（depends_on 已处理）
#    - 首次启动 Prosody 会初始化用户密码，可能需要 10-20 秒
#    - 如果 Jicofo 连接 Prosody 失败，等 Prosody 就绪后会自动重连
# ============================================================================

# === 镜像版本 ===
JITSI_IMAGE_VERSION=stable-9646

# === 配置目录 ===
CONFIG=./jitsi-meet-cfg

# === 端口配置 ===
HTTP_PORT=19407
HTTPS_PORT=19447
JVB_PORT=19107
JVB_HTTP_PORT=19088

# === 时区 ===
TZ=Asia/Shanghai

# === 域名配置 ===
# 只需修改 LOCAL_IP，下面的 PUBLIC_URL / JVB_ADVERTISE_URLS / JVB_ADVERTISE_IPS 会自动引用
LOCAL_IP=your-server-ip
PUBLIC_URL=https://${LOCAL_IP}:19447
XMPP_DOMAIN=meet.jitsi
XMPP_SERVER=prosody
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_BOSH_URL_BASE=http://prosody:5280
XMPP_GUEST_DOMAIN=guest.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_RECORDER_DOMAIN=recorder.meet.jitsi
XMPP_CROSS_DOMAIN=true

# === 鉴权配置 ===
ENABLE_AUTH=1
ENABLE_GUESTS=1
AUTH_TYPE=jwt
ENABLE_LOBBY=0

# === JWT 配置（HS256 共享密钥，必须与后端 JWT_SHARED_SECRET 一致） ===
JWT_APP_ID=meeting-ai
JWT_APP_SECRET=your-jwt-shared-secret
JWT_ACCEPTED_ISSUERS=meeting-ai
JWT_ACCEPTED_AUDIENCES=jitsi
JWT_ALLOW_EMPTY=0
JWT_AUTH_TYPE=token
JWT_TOKEN_AUTH_MODULE=token_verification

# === HTTPS 配置 ===
DISABLE_HTTPS=0
ENABLE_HTTP_REDIRECT=0
ENABLE_LETSENCRYPT=0
JVB_DISABLE_TLS=1

# === JVB 配置 ===
JVB_ADVERTISE_URLS=wss://${LOCAL_IP}:19447
JVB_STUN_SERVERS=stun.l.google.com:19302
JVB_AUTH_USER=jvb
JVB_AUTH_PASSWORD=your-jvb-auth-password
JVB_XMPP_PASSWORD=your-jvb-xmpp-password
JVB_BREWERY_MUC=jvbbrewery
JVB_ADVERTISE_IPS=${LOCAL_IP}

# === Jicofo 配置 ===
JICOFO_AUTH_URL=auth.meet.jitsi
JICOFO_AUTH_PASSWORD=your-jicofo-auth-password
JICOFO_COMPONENT_SECRET=your-component-secret

# === Jibri 配置（转录/录制，暂不启用） ===
JIBRI_BREWERY_MUC=jibribrewery
JIBRI_PENDING_TIMEOUT=90
JIBRI_RECORDER_USER=recorder
JIBRI_RECORDER_PASSWORD=your-jibri-recorder-password
JIBRI_XMPP_USER=jibri
JIBRI_XMPP_PASSWORD=your-jibri-xmpp-password

# === Jigasi 配置（SIP/转录，暂不启用） ===
JIGASI_BREWERY_MUC=jigasibrewery
JIGASI_SIP_URI=
JIGASI_XMPP_USER=jigasi
JIGASI_XMPP_PASSWORD=your-jigasi-xmpp-password

# === 日志级别 ===
JICOFO_DEBUG=0
JVB_DEBUG=0
LOG_LEVEL=info

# === 重启策略 ===
RESTART_POLICY=unless-stopped

# === 其他 ===
ENABLE_XMPP_WEBSOCKET=1
ENABLE_AUTO_OWNER=1
