# Jitsi 本地开发环境配置 - 示例文件
# 复制此文件为 .env 并填写实际值

# === 镜像版本 ===
JITSI_IMAGE_VERSION=stable-9646

# === 配置目录 ===
CONFIG=./jitsi-meet-cfg

# === 端口配置 ===
HTTP_PORT=8000
HTTPS_PORT=8443
JVB_PORT=10000
JVB_HTTP_PORT=8081

# === 时区 ===
TZ=Asia/Shanghai

# === 域名配置 ===
PUBLIC_URL=https://your-server-ip:8443
XMPP_DOMAIN=meet.jitsi
XMPP_SERVER=prosody
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_BOSH_URL_BASE=http://prosody:5280
XMPP_GUEST_DOMAIN=guest.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_RECORDER_DOMAIN=recorder.meet.jitsi
XMPP_CROSS_DOMAIN=true

# === 鉴权配置（开发阶段关闭） ===
ENABLE_AUTH=0
ENABLE_GUESTS=1
AUTH_TYPE=internal
ENABLE_LOBBY=0

# === HTTPS 配置 ===
DISABLE_HTTPS=0
ENABLE_HTTP_REDIRECT=0
ENABLE_LETSENCRYPT=0
JVB_DISABLE_TLS=1

# === JVB 配置 ===
JVB_ADVERTISE_URLS=wss://your-server-ip:8443
JVB_STUN_SERVERS=stun.l.google.com:19302
JVB_AUTH_USER=jvb
JVB_AUTH_PASSWORD=your-jvb-auth-password
JVB_XMPP_PASSWORD=your-jvb-xmpp-password
JVB_BREWERY_MUC=jvbbrewery
JVB_ADVERTISE_IPS=your-server-ip

# === Jicofo 配置 ===
JICOFO_AUTH_URL=auth.meet.jitsi
JICOFO_AUTH_PASSWORD=your-jicofo-auth-password
JICOFO_COMPONENT_SECRET=your-component-secret

# === Jibri 配置（转录/录制，暂不启用） ===
JIBRI_BREWERY_MUC=jibribrewery
JIBRI_PENDING_TIMEOUT=90
JIBRI_RECORDER_USER=recorder
JIBRI_RECORDER_PASSWORD=your-jibri-recorder-password
JIBRI_XMPP_USER=jibri
JIBRI_XMPP_PASSWORD=your-jibri-xmpp-password

# === Jigasi 配置（SIP/转录，暂不启用） ===
JIGASI_BREWERY_MUC=jigasibrewery
JIGASI_SIP_URI=
JIGASI_XMPP_USER=jigasi
JIGASI_XMPP_PASSWORD=your-jigasi-xmpp-password

# === 日志级别 ===
JICOFO_DEBUG=0
JVB_DEBUG=0
LOG_LEVEL=info

# === 重启策略 ===
RESTART_POLICY=unless-stopped

# === 其他 ===
ENABLE_XMPP_WEBSOCKET=1
ENABLE_AUTO_OWNER=1