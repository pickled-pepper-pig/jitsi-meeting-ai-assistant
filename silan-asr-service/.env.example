# ============================================
# SiLAN FunASR 服务 - 环境变量配置
# ============================================
# 复制此文件为 .env 并根据实际情况修改

# 服务配置
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=19087

# ASR 配置
ASR_DEVICE=cpu
ASR_MAX_BATCH_SIZE=32
ASR_MAX_SESSIONS=100

# 热词文件路径 (可选)
# HOTWORD_FILE=resources/vocab/semiconductor_vocab.txt

# Kafka 配置 (可选，默认禁用)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ============================================
# JWT 认证配置（必须与 jitsi/.env 中的 JWT_APP_SECRET 一致）
# ============================================
JWT_ALGORITHM=HS256
JWT_SHARED_SECRET=change-this-to-your-shared-secret

# ============================================
# LLM 配置 (会议总结)
# 未配置 LLM_API_KEY 时回退到简单统计模式
# ============================================
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://slapi.silan.com.cn/v1
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_MAX_INPUT_CHARS=60000
